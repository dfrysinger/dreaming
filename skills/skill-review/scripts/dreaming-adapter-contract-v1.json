{
  "contract_version": 1,
  "transport": {
    "argv": "UTF-8 command arguments",
    "stdout": "one JSON object per line; no non-JSON output",
    "stderr": "diagnostics only",
    "failure": "nonzero exit plus a final {\"ok\":false,\"error\":{\"code\":...,\"message\":...}} object"
  },
  "handshake": {
    "command": ["contract", "--role", "<session-source|review-executor|skill-publisher>"],
    "required_response": {
      "ok": true,
      "protocol": "dreaming.<role>",
      "version": 1,
      "adapter_id": "stable opaque adapter identifier",
      "capabilities": ["role-specific capability names"]
    }
  },
  "session-source": {
    "commands": {
      "watermark": "returns {watermark}",
      "list": "accepts --floor, --ceiling, --cursor, --page-size; returns {items,next_cursor,exhausted}",
      "inspect": "accepts --session; returns {session}",
      "render": "accepts --session; returns {events,truncated}",
      "doctor": "returns {healthy:true}"
    },
    "required_capabilities": ["stable-pagination", "qualified-identity", "bounded-render", "revision-inspect"]
  },
  "review-executor": {
    "commands": {
      "version": "returns {executor_version}",
      "doctor": "returns {healthy:true,boundary_ready:true}",
      "run": "accepts --snapshot and --result; writes a structured result and emits the same result"
    },
    "required_capabilities": ["source-blind", "mutation-fence", "completion-sentinel"]
  },
  "skill-publisher": {
    "commands": {
      "doctor": "returns {healthy:true}",
      "inventory": "returns {owned_bundle_ids:[...]}",
      "install": "accepts --bundle and --bundle-id",
      "verify": "accepts --bundle-id; returns {verified:true,bundle_id:<same id>}",
      "remove": "removes only registrations owned by this adapter"
    },
    "required_capabilities": ["content-addressed-bundle", "ownership-safe-remove", "exact-inventory"]
  }
}
